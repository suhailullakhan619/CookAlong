   "steps": [
    {
     "id": "s1",
     "order": 1,
     "instructionText": "Wash the aubergines, cut each in half lengthways, then cut each half into diamond-shaped chunks. Put them in a bowl.",
     "relatedIngredientIds": [
      "slender-aubergines"
     ]
    },
    {
     "id": "s2",
     "order": 2,
     "instructionText": "Wash the scallions and chop them. Break up the star anise.",
