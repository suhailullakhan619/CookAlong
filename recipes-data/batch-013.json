{
 "recipes": [
  {
   "id": "tomato-egg-stir-fry",
   "title": "Tomato and Egg Stir-fry",
   "description": "Soft scrambled egg folded into juicy, lightly sweet stir-fried tomato.",
   "prepTime": 10,
   "cookTime": 5,
   "servings": 2,
   "dietaryTags": [
    "vegetarian"
   ],
   "categories": [
    "chinese",
    "quick"
   ],
   "ingredients": [
    {
     "id": "tomatoes",
     "name": "tomatoes (about 360 g)",
     "amount": 2.0,
     "unit": ""
    },
    {
     "id": "eggs",
     "name": "eggs",
     "amount": 3.0,
     "unit": ""
    },
    {
     "id": "cooking-oil",
     "name": "cooking oil",
     "amount": 12.0,
     "unit": "ml"
    },
    {
     "id": "salt",
     "name": "salt",
     "amount": 3.0,
     "unit": "g"
    },
    {
     "id": "sugar",
     "name": "sugar, optional",
     "amount": 2.0,
     "unit": "g"
    },
    {
     "id": "chopped-scallion",
     "name": "chopped scallion, optional",
     "amount": 1.0,
     "unit": "tbsp"
    }
   ],
   "steps": [
    {
     "id": "s1",
     "order": 1,
     "instructionText": "Wash the tomatoes. Optionally blanch them in boiling water, then cold water, and peel. Cut the tomatoes into pieces no bigger than 4 cm.",
     "relatedIngredientIds": [
      "tomatoes",
      "sugar",
      "chopped-scallion"
     ]
    },
    {
     "id": "s2",
     "order": 2,
     "instructionText": "Crack the eggs into a bowl, add 2 g of the salt and beat well.",
     "relatedIngredientIds": [
      "eggs",
      "salt"
     ]
    },
    {
     "id": "s3",
     "order": 3,
     "instructionText": "Heat the wok and add the oil. When it is hot, pour in the eggs and stir-fry until just set and lightly yellow. Turn off the heat and move the eggs to a plate. Do not wash the wok.",
     "relatedIngredientIds": [
      "eggs"
     ],
     "animation": "fry"
    },
    {
     "id": "s4",
     "order": 4,
     "instructionText": "Turn the heat back on and add the tomato pieces. Press them with the spatula and stir-fry for 20 seconds, or until soft.",
     "relatedIngredientIds": [
      "tomatoes"
     ],
     "animation": "fry",
     "suggestedTimerSeconds": 20,
     "timerLabel": "Fry"
    },
    {
     "id": "s5",
     "order": 5,
     "instructionText": "Return the eggs to the wok and toss everything together.",
     "relatedIngredientIds": [
      "eggs"
     ]
    },
    {
     "id": "s6",
     "order": 6,
     "instructionText": "Add the remaining salt, the sugar if you like it sweeter, and the scallion. Stir to mix, then turn off the heat and serve.",
     "relatedIngredientIds": [
      "salt",
      "sugar",
      "chopped-scallion"
     ]
    }
   ],
