     "amount": 50.0,
     "unit": "ml"
    }
   ],
   "steps": [
    {
     "id": "s1",
     "order": 1,
     "instructionText": "Wash the cauliflower and break it into small florets. Slice any thick stems. Peel the garlic and slice it.",
     "relatedIngredientIds": [
      "cauliflower",
      "garlic"
     ]
    },
    {
     "id": "s2",
     "order": 2,
     "instructionText": "Bring 1000 ml of water to a boil. Blanch the cauliflower for 2-3 minutes, until it turns paler and slightly soft. Drain.",
     "relatedIngredientIds": [
      "cauliflower",
      "water"
     ],
     "animation": "boil",
     "suggestedTimerSeconds": 180,
     "timerLabel": "Boil"
    },
    {
     "id": "s3",
     "order": 3,
     "instructionText": "Heat the oil in a wok over high heat. Add the garlic slices and fry briefly until fragrant.",
     "relatedIngredientIds": [
      "garlic"
     ],
     "animation": "fry"
    },
    {
     "id": "s4",
     "order": 4,
     "instructionText": "Add the cauliflower and stir-fry over medium-high heat for about 2 minutes.",
     "relatedIngredientIds": [
      "cauliflower"
     ],
     "suggestedTimerSeconds": 120,
     "timerLabel": "Heat"
    },
    {
     "id": "s5",
     "order": 5,
     "instructionText": "Add the salt and keep stirring.",
     "relatedIngredientIds": [
      "salt"
     ]
    },
    {
     "id": "s6",
     "order": 6,
     "instructionText": "Pour the water down the side of the wok, cover and steam for 1 minute so the cauliflower cooks through.",
     "relatedIngredientIds": [
      "cauliflower",
      "water"
     ],
     "animation": "pour",
     "suggestedTimerSeconds": 60,
     "timerLabel": "Steam"
    },
    {
     "id": "s7",
     "order": 7,
     "instructionText": "Uncover, toss quickly and serve.",
