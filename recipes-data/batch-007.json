   ],
   "steps": [
    {
     "id": "s1",
     "order": 1,
     "instructionText": "Separate albumen and yolks and beat the latter with the sugar in a bowl.",
     "relatedIngredientIds": [
      "sugar"
     ]
    },
    {
     "id": "s2",
     "order": 2,
     "instructionText": "Add the mascarpone and stir until uniform.",
     "relatedIngredientIds": [
      "mascarpone"
     ]
    },
    {
     "id": "s3",
     "order": 3,
     "instructionText": "In another bowl, beat the albumens until stiff.",
     "relatedIngredientIds": []
    },
    {
     "id": "s4",
     "order": 4,
     "instructionText": "Add beaten albumens to the mascarpone cream gradually, stirring gently to not destroy the foam.",
     "relatedIngredientIds": [
      "mascarpone"
     ]
    },
    {
     "id": "s5",
     "order": 5,
     "instructionText": "Cover the bottom of a baking tray with a layer of cream.",
     "relatedIngredientIds": []
    },
    {
     "id": "s6",
     "order": 6,
     "instructionText": "Cover it with a layer of savoiardi biscuits soaked in coffee.",
     "relatedIngredientIds": [
      "savoiardi-biscuits"
     ]
    },
    {
     "id": "s7",
     "order": 7,
     "instructionText": "Add another layer of cream, then another of coffee-soaked savoiardi.",
     "relatedIngredientIds": []
    },
    {
     "id": "s8",
     "order": 8,
     "instructionText": "Savoiardi of the second layer should be orthogonal to those of the first, so that the structure is more solid and slices collapse less when they are moved.",
     "relatedIngredientIds": []
    },
    {
     "id": "s9",
     "order": 9,
     "instructionText": "Add one last layer of cream.",
     "relatedIngredientIds": []
    },
    {
     "id": "s10",
     "order": 10,
     "instructionText": "Sprinkle cocoa powder on top.",
     "relatedIngredientIds": [
      "cocoa-powder"
     ]
    },
    {
     "id": "s11",
     "order": 11,
     "instructionText": "Store in the fridge for three hours.",
     "relatedIngredientIds": [],
     "suggestedTimerSeconds": 10800,
     "timerLabel": "Timer"
    }
   ],
