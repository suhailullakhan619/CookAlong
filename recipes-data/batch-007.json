   ],
   "ingredients": [
    {
     "id": "warm-water",
     "name": "warm water",
     "amount": 600.0,
     "unit": "ml"
    },
    {
     "id": "dry-active-baking-yeast",
     "name": "dry active baking yeast",
     "amount": 1.0,
     "unit": "tbsp"
    },
    {
     "id": "honey",
     "name": "honey",
     "amount": 7.0,
     "unit": "tbsp"
    },
    {
     "id": "flour",
     "name": "flour",
     "amount": 1.5,
     "unit": "kg"
    },
    {
     "id": "eggs",
     "name": "eggs",
     "amount": 3.0,
     "unit": ""
    },
    {
     "id": "salt",
     "name": "salt",
     "amount": 1.0,
     "unit": "tbsp"
    },
    {
     "id": "poppy-seeds",
     "name": "poppy seeds",
     "amount": 1.0,
     "unit": "tbsp"
    },
    {
     "id": "olive-oil",
     "name": "olive oil",
     "amount": 4.0,
     "unit": "tbsp"
    }
   ],
   "steps": [
    {
     "id": "s1",
     "order": 1,
     "instructionText": "Fill a large bowl with the water, and sprinkle with the yeast.",
     "relatedIngredientIds": [
      "warm-water",
      "dry-active-baking-yeast"
     ]
    },
    {
     "id": "s2",
     "order": 2,
     "instructionText": "Whisk together: honey, oil, 2 eggs, and salt. Add to bowl.",
     "relatedIngredientIds": [
      "honey",
      "eggs",
      "salt"
     ],
     "animation": "mix"
    },
    {
     "id": "s3",
     "order": 3,
     "instructionText": "Add flour to bowl in small amounts, beating/whisking after each addition.",
     "relatedIngredientIds": [
      "flour"
     ]
    },
    {
     "id": "s4",
     "order": 4,
     "instructionText": "Once the mixtures becomes a viscous dough, begin kneading until smooth and elastic, and no longer sticky.",
     "relatedIngredientIds": []
    },
    {
     "id": "s5",
     "order": 5,
     "instructionText": "Cover bowl with a damp cloth and let rise for 1-2 hours, or until dough has doubled in size.",
     "relatedIngredientIds": [],
     "suggestedTimerSeconds": 7200,
     "timerLabel": "Rise"
    },
    {
     "id": "s6",
     "order": 6,
     "instructionText": "Sprinkle flour onto a chopping board, place the dough onto it and divide in half.",
     "relatedIngredientIds": [
      "flour"
     ]
    },
    {
     "id": "s7",
     "order": 7,
     "instructionText": "Knead each half, adding flour as needed to keep the dough non-sticky.",
     "relatedIngredientIds": [
      "flour"
     ],
     "animation": "mix"
    },
    {
     "id": "s8",
     "order": 8,
     "instructionText": "Divide each half into thirds and roll into a long snake about 4cm (1.5in) in girth.",
     "relatedIngredientIds": []
    },
    {
     "id": "s9",
     "order": 9,
     "instructionText": "Pinch the ends of the each three snakes together firmly and plait them together, making two items of braided dough.",
     "relatedIngredientIds": []
    },
    {
     "id": "s10",
     "order": 10,
     "instructionText": "Grease two baking trays or use baking paper, cover with dry cloth and let rise for one hour. Preheat oven to 190°C / Gas mark 5.",
     "relatedIngredientIds": [],
     "suggestedTimerSeconds": 3600,
     "timerLabel": "Rise"
    },
    {
     "id": "s11",
     "order": 11,
     "instructionText": "Whisk an egg and brush onto each plait, sprinkle with seeds.",
     "relatedIngredientIds": [
      "eggs",
      "poppy-seeds"
     ],
     "animation": "mix"
    },
    {
     "id": "s12",
     "order": 12,
     "instructionText": "Bake until bread has a hollow sound when tapped, cool on a rack for an hour before slicing.",
     "relatedIngredientIds": [],
     "animation": "bake",
     "suggestedTimerSeconds": 3600,
     "timerLabel": "Cool"
