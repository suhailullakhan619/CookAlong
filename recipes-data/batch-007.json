   "id": "kvass",
   "title": "Kvass",
   "description": "Slavic fermented bread drink.",
   "prepTime": 30,
   "cookTime": 0,
   "servings": 6,
   "dietaryTags": [
    "vegetarian"
   ],
   "categories": [
    "drink"
   ],
   "ingredients": [
    {
     "id": "raisins",
     "name": "raisins",
     "amount": 100.0,
     "unit": "g"
    },
    {
     "id": "sugar",
     "name": "sugar",
     "amount": 100.0,
     "unit": "g"
    },
    {
     "id": "black-bread",
     "name": "black bread (e.g. pumpernickel bread, rye bread)",
     "amount": 3.0,
     "unit": "slice"
    },
    {
     "id": "lemons",
     "name": "lemons",
     "amount": 1.0,
     "unit": ""
    },
    {
     "id": "pkg-of-active-dry-yeast",
     "name": "pkg of active dry yeast",
     "amount": 1.0,
     "unit": ""
    },
    {
     "id": "a-handful-of-coffee-bean",
     "name": "A handful of coffee beans (optional)",
     "amount": null,
     "unit": "to taste"
    },
    {
     "id": "non-citrus-fruits",
     "name": "Non-citrus fruits, e.g. plums, apples, kiwi (optional)",
     "amount": null,
     "unit": "to taste"
    }
   ],
   "steps": [
    {
     "id": "s1",
     "order": 1,
     "instructionText": "Bring 1 L of water in a pot to a boil.",
     "relatedIngredientIds": [],
     "animation": "boil"
    },
    {
     "id": "s2",
     "order": 2,
     "instructionText": "Burn black bread in a toaster or in an oven until it is thoroughly scorched to blackness on the outside.",
     "relatedIngredientIds": [
      "black-bread"
     ]
    },
    {
     "id": "s3",
     "order": 3,
     "instructionText": "Once the water has come to boil, remove off heat. Add burned black bread, a handful of raisins, a few slices of lemon, and coffee beans to the pot.",
     "relatedIngredientIds": [
      "raisins",
      "black-bread",
      "lemons",
      "a-handful-of-coffee-bean"
     ]
    },
    {
     "id": "s4",
     "order": 4,
     "instructionText": "Leave contents of the pot to cool down to room temperature.",
     "relatedIngredientIds": [],
     "animation": "rest"
    },
    {
     "id": "s5",
     "order": 5,
     "instructionText": "Filter out everything from the pot through a strainer, and pour contents into a separate, sterilized container.",
     "relatedIngredientIds": []
    },
    {
     "id": "s6",
     "order": 6,
     "instructionText": "Add sugar and yeast into the container, and stir until sugar is dissolved. This starts the fermentation process.",
     "relatedIngredientIds": [
      "sugar",
      "pkg-of-active-dry-yeast"
     ]
    },
    {
     "id": "s7",
     "order": 7,
     "instructionText": "The amount of sugar in this recipe should yield 1.0%-2.5% alcohol by total volume at the end of the fermentation process.",
     "relatedIngredientIds": [
      "sugar"
     ]
    },
    {
     "id": "s8",
     "order": 8,
     "instructionText": "Add rest of raisins, and non-citrus fruits of your choice. The fruits will positively impact flavour of the final product.",
     "relatedIngredientIds": [
      "raisins",
      "non-citrus-fruits"
     ],
     "animation": "rest"
    },
    {
     "id": "s9",
     "order": 9,
     "instructionText": "If mixture is not already in a mason jar, pour the mixture into a sterile mason jar, and seal the lid. Place the jar in a warm place (26-30°C; 79-86°F), and let it ferment for a week, or until it stops bubbling.",
     "relatedIngredientIds": []
    },
    {
     "id": "s10",
     "order": 10,
     "instructionText": "Remove all raisins and fruits from the jar.",
     "relatedIngredientIds": [
      "raisins",
      "non-citrus-fruits"
     ]
    },
    {
     "id": "s11",
     "order": 11,
     "instructionText": "Squeeze lemon juice from lemons into the mixture. You may drink the now-complete kvass right away, or refrigerate it before drinking.",
     "relatedIngredientIds": [
      "lemons"
     ]
    }
   ],
