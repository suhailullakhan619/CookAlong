  {
   "id": "italian-bread",
   "title": "Italian Bread",
   "description": "Basic Italian-style yeast loaf.",
   "prepTime": 30,
   "cookTime": 30,
   "servings": 8,
   "dietaryTags": [
    "vegetarian"
   ],
   "categories": [
    "baking",
    "italian"
   ],
   "ingredients": [
    {
     "id": "bread-flour",
     "name": "bread flour (or all-purpose if not available)",
     "amount": 600.0,
     "unit": "g"
    },
    {
     "id": "packet",
     "name": "packet (appr. 2 1/4 tsp or 7g) active dry yeast",
     "amount": 1.0,
     "unit": ""
    },
    {
     "id": "olive-oil-for-greasing",
     "name": "olive oil for greasing",
     "amount": null,
     "unit": "to taste"
    }
   ],
   "steps": [
    {
     "id": "s1",
     "order": 1,
     "instructionText": "Follow directions on the packet to activate yeast in a bowl large enough for mixing the dough",
     "relatedIngredientIds": [
      "packet"
     ]
    },
    {
     "id": "s2",
     "order": 2,
     "instructionText": "Add enough water for a total of 400g or 1 3/4 cups (i.e. add 400g minus however much water was used to activate the yeast)",
     "relatedIngredientIds": [
      "packet"
     ]
    },
    {
     "id": "s3",
     "order": 3,
     "instructionText": "Optionally add 12g or 2 tsp salt (Unsalted bread is normal in Central Italy, but it's an acquired taste)",
     "relatedIngredientIds": []
    },
    {
     "id": "s4",
     "order": 4,
     "instructionText": "Slowly mix in flour until it forms a dough that will be easy to work with and not overly sticky. Make sure there are no wet or dry pockets in the dough.",
     "relatedIngredientIds": [
      "bread-flour"
     ],
     "animation": "mix"
    },
    {
     "id": "s5",
     "order": 5,
     "instructionText": "Cover and let rest for 15 minutes.",
     "relatedIngredientIds": [],
     "suggestedTimerSeconds": 900,
     "timerLabel": "Rest"
    },
    {
     "id": "s6",
     "order": 6,
     "instructionText": "Knead the dough and let it rise covered for 1 hour in a warm place until doubled in size.",
     "relatedIngredientIds": [],
     "animation": "mix",
     "suggestedTimerSeconds": 3600,
     "timerLabel": "Rise"
    },
    {
     "id": "s7",
     "order": 7,
     "instructionText": "Split the dough in half and shape it into two loaves. Make sure the seams are at the bottom.",
     "relatedIngredientIds": []
    },
    {
     "id": "s8",
     "order": 8,
     "instructionText": "Place the loaves on a lightly greased baking sheet and let it rise covered for 1 hour in a warm place until doubled in size.",
     "relatedIngredientIds": [],
     "suggestedTimerSeconds": 3600,
     "timerLabel": "Rise"
    },
    {
     "id": "s9",
     "order": 9,
     "instructionText": "Make sure the oven is preheated to 200°C before the resting period is over.",
     "relatedIngredientIds": []
    },
    {
     "id": "s10",
     "order": 10,
     "instructionText": "Score the loaves and place the baking sheet in the oven.",
     "relatedIngredientIds": []
    },
    {
     "id": "s11",
     "order": 11,
     "instructionText": "Bake for 25-30 minutes.",
