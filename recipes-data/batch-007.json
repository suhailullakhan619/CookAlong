   "id": "challah-bread",
   "title": "Challah Bread",
   "description": "Braided Jewish egg bread.",
   "prepTime": 20,
   "cookTime": 40,
   "servings": 12,
   "dietaryTags": [
    "vegetarian"
   ],
   "categories": [
    "baking",
